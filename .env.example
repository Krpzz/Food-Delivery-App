# ──────────────────────────────────────────────────────────────
# This file documents every environment variable used across the
# whole project. In practice, each app reads its own .env file:
#   - copy the backend-relevant vars into backend/.env
#   - copy the frontend-relevant vars into frontend/.env
# (See backend/.env.example and frontend/.env.example for the
# split-out versions, and README.md for setup steps.)
# ──────────────────────────────────────────────────────────────

# --- Backend ---
PORT=5000
NODE_ENV=development
MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=30d

CLIENT_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_BASE_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_CHECK_URL=https://uat.esewa.com.np/api/epay/transaction/status/
ESEWA_SUCCESS_URL=http://localhost:5173/payment/esewa/success
ESEWA_FAILURE_URL=http://localhost:5173/payment/esewa/failure

# Used once, by `npm run seed`, to create the first admin account.
SEED_ADMIN_EMAIL=admin@fooddelivery.com.np
SEED_ADMIN_PASSWORD=ChangeMe123!

# --- Frontend (must be prefixed VITE_ to be exposed to client code) ---
VITE_API_BASE_URL=http://localhost:5000/api
